# Gizli anahtarlar — ASLA repoya girmez
.env
*.key

# Python
__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Veri ve modeller (büyük dosyalar — git'e değil)
data/raw/*
data/labeled/*
data/processed/*
!data/raw/.gitkeep
!data/labeled/.gitkeep
!data/processed/.gitkeep
models/*.tflite
models/*.h5
models/*.pt
models/*.onnx

# Notebook checkpoint
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Logs and temp files
*.log

# Streamlit yerel sırları — config.toml (tema) repoya girer, gizli bilgiler girmez
.streamlit/secrets.toml
.streamlit/credentials.toml
app/prototype/.streamlit/secrets.toml
app/prototype/.streamlit/credentials.toml

